<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Pages.PoiDetailPage">

       <Grid BackgroundColor="#80000000">

              <Border Margin="30"
                      Padding="20"
                      Stroke="Transparent"
                      StrokeShape="RoundRectangle 20"
                      BackgroundColor="White"
                      VerticalOptions="Center">

                     <ScrollView Padding="0,0,0,15">
                            <VerticalStackLayout Spacing="12">

                                   <Image Source="{Binding Image}"
                                          HeightRequest="200"
                                          Aspect="AspectFill"
                                          BackgroundColor="#f0f0f0" />

                                   <Label Text="{Binding Name}"
                                          FontSize="22"
                                          FontAttributes="Bold"
                                          TextColor="#333"
                                          Margin="0,5,0,0" />

                                   <VerticalStackLayout>
                                          <Label Text="📍 Địa chỉ:"
                                                 FontSize="14"
                                                 FontAttributes="Bold"
                                                 TextColor="#555" />
                                          <Label Text="{Binding Address}"
                                                 FontSize="14"
                                                 TextColor="#666"
                                                 LineBreakMode="WordWrap" />
                                   </VerticalStackLayout>

                                   <VerticalStackLayout>
                                          <Label Text="📝 Thông tin:"
                                                 FontSize="14"
                                                 FontAttributes="Bold"
                                                 TextColor="#555" />
                                          <Label x:Name="DescriptionLabel"
                                                 Text="{Binding Description}"
                                                 FontSize="14"
                                                 TextColor="#666"
                                                 LineBreakMode="WordWrap" />
                                   </VerticalStackLayout>

                                   <Button x:Name="AudioButton"
                                           Text="▶️ Play Audio"
                                           Clicked="OnPlayAudioClicked"
                                           BackgroundColor="#7851a9"
                                           TextColor="White"
                                           FontSize="16"
                                           Padding="15"
                                           Margin="0,15,0,0"
                                           CornerRadius="10" />

                            </VerticalStackLayout>
                     </ScrollView>

              </Border>

       </Grid>

</ContentPage>