<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Pages.PoiDetailPage">

       <Grid BackgroundColor="#80000000">

              <Frame Margin="30"
                     Padding="20"
                     CornerRadius="20"
                     BackgroundColor="White"
                     VerticalOptions="FillAndExpand"
                     HasShadow="True">

                     <Grid RowDefinitions="*" RowSpacing="0">

                            <!-- ScrollView for Content -->
                            <ScrollView Grid.Row="0" Padding="15">
                                   <VerticalStackLayout Spacing="12">

                                          <!-- Image -->
                                          <Image Source="{Binding Image}"
                                                 HeightRequest="200"
                                                 Aspect="AspectFill">
                                                 <Image.Clip>
                                                        <RoundRectangleGeometry CornerRadius="10"/>
                                                 </Image.Clip>
                                          </Image>

                                          <!-- Tên POI -->
                                          <Label Text="{Binding Name}"
                                                 FontSize="22"
                                                 FontAttributes="Bold"
                                                 TextColor="#333"/>

                                          <!-- Địa chỉ -->
                                          <VerticalStackLayout>
                                                 <Label Text="📍 Địa chỉ:"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#555"/>
                                                 <Label Text="{Binding Address}"
                                                        FontSize="14"
                                                        TextColor="#666"
                                                        LineBreakMode="WordWrap"/>
                                          </VerticalStackLayout>

                                          <!-- Description -->
                                          <VerticalStackLayout>
                                                 <Label Text="📝 Thông tin:"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#555"/>
                                                 <Label x:Name="DescriptionLabel"
                                                        Text="{Binding Description}"
                                                        FontSize="14"
                                                        TextColor="#666"
                                                        LineBreakMode="WordWrap"/>
                                          </VerticalStackLayout>

                                          <!-- Play Audio Button -->
                                          <Button x:Name="AudioButton"
                                                  Text="▶️ Play Audio"
                                                  Clicked="OnPlayAudioClicked"
                                                  BackgroundColor="#7851a9"
                                                  TextColor="White"
                                                  FontSize="16"
                                                  Padding="15"
                                                  Margin="0,15,0,0"
                                                  CornerRadius="10"/>

                                   </VerticalStackLayout>
                            </ScrollView>

                     </Grid>

              </Frame>

       </Grid>

</ContentPage>