<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Pages.PoiListPage">

    <CollectionView x:Name="PoiList">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10"
                       Padding="15"
                       CornerRadius="15"
                       HasShadow="True">

                    <VerticalStackLayout>
                        <Label Text="{Binding name}"
                               FontSize="18"
                               FontAttributes="Bold"/>

                        <Label Text="{Binding distance}"
                               TextColor="Gray"/>

                        <Button Text="Detail"
                                Clicked="OnDetailClicked"/>
                    </VerticalStackLayout>

                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>