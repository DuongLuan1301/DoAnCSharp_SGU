<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Pages.PoiListPage">

    <CollectionView x:Name="PoiList">
        <CollectionView.ItemTemplate>
            <DataTemplate>

                <Border Margin="12"
                        Padding="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 15"
                        BackgroundColor="White">

                    <Grid RowDefinitions="200,Auto"
                          RowSpacing="0">

                        <Image Grid.Row="0"
                               Source="{Binding Image}"
                               Aspect="AspectFill"
                               BackgroundColor="#f0f0f0"
                               IsVisible="{Binding Image}"/>

                        <VerticalStackLayout Grid.Row="1"
                                             Padding="15"
                                             Spacing="10">

                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#2c3e50"/>

                            <Label Text="{Binding Address}"
                                   FontSize="13"
                                   TextColor="#7f8c8d"
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="{Binding Distance}"
                                   FontSize="13"
                                   TextColor="#27ae60"
                                   FontAttributes="Bold"/>

                            <Button Text="Details"
                                    Clicked="OnDetailClicked"
                                    BackgroundColor="#7851a9"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="10,8"
                                    Margin="0,5,0,0"
                                    CornerRadius="8"
                                    IsVisible="{Binding Lat}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>