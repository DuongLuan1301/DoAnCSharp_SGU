<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="project_csharp_sgu.Pages.HomePage"
             Title="Home"
             BackgroundColor="#F5F5F5">

    <Grid>

        <!-- 🔥 MAP FULL SCREEN -->
        <Frame CornerRadius="0"
               Padding="0"
               HasShadow="False">

            <mapsui:MapControl x:Name="MyMap"/>
        </Frame>

        <!-- 🔥 OVERLAY UI -->
        <Grid>

            <!-- 🔹 LANGUAGE BUTTON (TOP LEFT) -->
            <Frame WidthRequest="45"
                   HeightRequest="45"
                   CornerRadius="22"
                   Padding="0"
                   BackgroundColor="White"
                   HasShadow="True"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                   Margin="15">

                <ImageButton Source="language.png"
                             BackgroundColor="Transparent"
                             Clicked="OnLanguageClicked"/>
            </Frame>

            <!-- 🔹 INFO PANEL (BOTTOM) -->
            <Frame Padding="15"
                   CornerRadius="20"
                   BackgroundColor="White"
                   HasShadow="True"
                   VerticalOptions="End"
                   Margin="15">

                <VerticalStackLayout Spacing="5">

                    <Label x:Name="LocationLabel"
                           FontSize="16"
                           TextColor="Gray"
                           FontFamily="OpenSansRegular"/>

                    <Label x:Name="AddressLabel"
                           FontSize="16"
                           TextColor="Gray"
                           FontFamily="OpenSansRegular"/>

                </VerticalStackLayout>
            </Frame>

        </Grid>

    </Grid>

</ContentPage>