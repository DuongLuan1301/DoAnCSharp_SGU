<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Pages.HomePage"
             Title="Home"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Spacing="15"
                         Padding="15,10,15,20">

        <!-- 🔹 ROW 1: LANGUAGE BUTTON -->
        <Grid>
            <Frame WidthRequest="45"
                   HeightRequest="45"
                   CornerRadius="22"
                   Padding="0"
                   BackgroundColor="White"
                   HasShadow="True"
                   HorizontalOptions="Start">

                <ImageButton Source="language.jpg"
                             BackgroundColor="Transparent"
                             Clicked="OnLanguageClicked"/>
            </Frame>
        </Grid>
        <!-- 🔹 ROW 2: MAP -->
        <Frame CornerRadius="20"
               BackgroundColor="#EAEAEA"
               HasShadow="True"
               HeightRequest="350">

            <Grid>
                <Label Text="MAP VIEW (GPS)"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray"/>
            </Grid>
        </Frame>
        <!-- 🔹 ROW 3: INFO PANEL -->
        <Frame Padding="15"
               CornerRadius="20"
               BackgroundColor="White"
               HasShadow="True">
            <VerticalStackLayout Spacing="5">
                <Label x:Name="LocationLabel"
                       FontSize="16"
                       TextColor="Gray"/>

                <Label x:Name="AddressLabel"
                       FontSize="16"
                       TextColor="Gray"/>

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>

</ContentPage>