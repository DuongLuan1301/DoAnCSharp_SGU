<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Pages.PoiListPage"
             Title="Danh sách hàng quán">

    <Grid RowDefinitions="*">
        <ListView x:Name="PoiList" 
                  HasUnevenRows="True"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Margin="10,5" Padding="15" CornerRadius="10" HasShadow="True">
                            <HorizontalStackLayout Spacing="15">
                                <BoxView WidthRequest="60" HeightRequest="60" Color="LightGray" CornerRadius="5"/>
                                
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18"/>
                                    <Label Text="{Binding Distance}" FontSize="14" TextColor="Gray"/>
                                    <Label Text="{Binding Address}" FontSize="12" TextColor="#8B7CF6"/>
                                    
                                    <Button Text="Xem chi tiết" 
                                            Clicked="OnDetailClicked"
                                            CommandParameter="{Binding .}"
                                            Margin="0,5,0,0"
                                            HeightRequest="35"
                                            FontSize="12"
                                            BackgroundColor="#8B7CF6"
                                            TextColor="White"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>