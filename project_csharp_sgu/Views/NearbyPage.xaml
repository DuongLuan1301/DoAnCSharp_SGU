<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="project_csharp_sgu.Views.NearbyPage"
             Title="Nearby Page">

    <CollectionView x:Name="nearbyCollection"
                    SelectionMode="None">

        <CollectionView.EmptyView>
            <Label
                Text="No nearby places yet"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="18"/>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <Border
                    Margin="10"
                    Padding="15"
                    BackgroundColor="pink">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Info -->
                        <VerticalStackLayout>

                            <Label
                                Text="{Binding Title}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding DistanceText}"
                                FontSize="14"
                                TextColor="Gray"/>
                        </VerticalStackLayout>

                        <!-- ACTION BUTTON -->
                        <Button
                            Grid.Column="1"
                            Text="Listen"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnListenClicked"/>

                    </Grid>

                </Border>

            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>